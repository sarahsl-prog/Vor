# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Credentials — never commit these, ever
.env
.env.*
# ...but the template of variable NAMES is meant to be committed. It holds
# placeholders only, never real values.
!.env.example
*service-account*.json
*credentials*.json
gcp-key*.json
*.pem
*.key

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local scratch
.pr_body_temp.md
*.log
.entire/
.superpowers/

# MLflow local scratch — the default file-store tracking backend writes these
# when tests run without MLFLOW_TRACKING_URI pointing at a real server.
mlruns/
mlflow.db
