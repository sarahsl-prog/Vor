# Vör — environment variable template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must
# never be committed (CLAUDE.md: "All secrets go in .env"). Nothing in
# this file is itself a secret — it is a checked-in list of the variable
# NAMES a fresh clone needs, with placeholder values only.
#
# In a real Cloud Run deployment these are set with `--set-env-vars`
# rather than a `.env` file; see docs/DEPLOY.md, which is the source of
# truth for deployment. This file is for local runs and for knowing what
# a deploy has to provide.

# --- Cloud Tasks audit queue (main.py: _queue_path, _audit_url, _enqueue) ---
# Required. /classify and /sweep raise no error without these — _enqueue()
# absorbs the resulting KeyError and logs it — but no audit is ever
# enqueued, so the whole re-verification loop silently does nothing.
GCP_PROJECT=your-project-id
TASKS_LOCATION=us-central1
TASKS_QUEUE=vor-audit-queue
TASKS_OIDC_SA_EMAIL=vor-scheduler@your-project-id.iam.gserviceaccount.com

# Base URL of the deployed Cloud Run service. Used to build the /audit
# callback URL Cloud Tasks posts back to, and as the OIDC token audience.
SERVICE_URL=https://your-cloud-run-url

# --- Vertex AI / Gemini (read by the google-adk + google-genai clients) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional. Overrides the model both agents use
# (vor_agents/model_config.py). Unset or blank falls back to
# DEFAULT_GEMINI_MODEL. Read per call, so it can be changed on the Cloud
# Run service without a code deploy.
# GEMINI_MODEL=gemini-2.0-flash

# --- Firestore ---
# Optional. Names a non-default Firestore database
# (vor_agents/firestore_config.py). Unset or blank means Firestore's
# unnamed "(default)" database. Every entrypoint that builds a client --
# the service and all three scripts/ -- honors it, so a migration run
# can't silently target the wrong database.
# FIRESTORE_DATABASE=vor-prod

# --- MLflow tracing (vor_agents/tracing.py) ---
# Optional. Read by the mlflow client itself, not by this repo's code.
# Unset, MLflow falls back to a local ./mlruns file store, which is NOT
# durable on Cloud Run — traces then land in the Firestore pending_traces
# fallback queue instead of a real tracking server. See DEPLOY.md step 5.
MLFLOW_TRACKING_URI=https://your-mlflow-server

# The dashboard's Traces / Home / Pipeline pages READ from this same
# tracking server -- MLflow is where agent runs live. Without it those
# pages fall back to demo data and say so, and the service itself logs
# every trace to the pending_traces queue instead (nothing is lost, but
# nothing is queryable until POST /replay-traces drains it).
# Note that MLflow 3.15 put the bare ./mlruns file store into maintenance
# mode and raises unless MLFLOW_ALLOW_FILE_STORE=true, so an unset
# tracking URI now means the fallback queue in practice, not a local
# store. Use a database backend (e.g. sqlite:///mlflow.db) locally.

# Optional, also read by the mlflow client rather than by this repo. Names
# the experiment runs are logged under. WITHOUT it every run lands in
# MLflow's "Default" experiment, so a shared tracking server mixes dev,
# staging and prod traces together with no way to tell them apart after
# the fact. Set it per environment.
# MLFLOW_EXPERIMENT_NAME=vor-prod
# Writer and dashboard resolve this through the same helper
# (vor_agents.tracing.mlflow_experiment_name), so they cannot disagree
# about which experiment holds the runs -- but they must both be given
# the same value.

# --- Tuning (vor_agents/env_config.py) ---
# Both optional, both integers, both read per call. A value that isn't a
# valid integer, or is below its minimum, is logged at WARNING and the
# default is used -- a typo in a deploy flag must never take a request
# path down.

# How many patterns one scheduled /sweep enqueues audits for. This is the
# sweep's cost/coverage dial: every target is a model call. Minimum 1 --
# 0 is rejected rather than honored, because it would silently disable
# the entire safety-net audit path while looking exactly like a healthy
# sweep that found nothing.
# SWEEP_MAX_TARGETS=10

# TTL for the in-process blast-radius table cache. Lower = a committed
# table entry goes live sooner; higher = fewer Firestore reads per sweep
# (the table is read once per confirmed instance). 0 is allowed and means
# never serve from cache.
# BLAST_RADIUS_CACHE_TTL_SECONDS=300

# Caps how many pending_traces docs one scheduled /replay-traces run reads
# into memory. Every run materializes this many docs at once, so it's the
# replay run's memory dial during an extended MLflow outage. Minimum 1 --
# a lower value is rejected and the default is used.
# TRACE_REPLAY_BATCH_SIZE=1000

# How long a queued trace survives before Firestore's TTL policy deletes
# it. Minimum 1; a bad value is logged and the default (30) used. The TTL
# policy targets `expires_at` (a real timestamp) rather than `queued_at`
# (an ISO string): Firestore TTL ignores non-timestamp fields entirely, so
# a policy on queued_at silently deleted nothing. See docs/DEPLOY.md.
# PENDING_TRACE_RETENTION_DAYS=30

# Backing store for ADK session state. Unset (the default) means an
# in-memory SQLite database -- fine for local dev and the test suite, but
# process-local. In production scripts/deploy.sh builds a Cloud SQL
# Postgres URL and mounts it from Secret Manager rather than as a
# plaintext env var, because it embeds the DB password -- do the same for
# any real value here, and never commit one. A URL that can't be used is
# logged and falls back to the in-memory default rather than failing
# startup.
# SESSION_DB_URL=postgresql+asyncpg://user:password@/dbname?host=/cloudsql/INSTANCE_CONNECTION_NAME

# --- Local development only ---
# Path to a service-account key JSON, if you are not using `gcloud auth
# application-default login`. Never commit the key file itself; the
# *.json patterns in .gitignore exist to make that harder to do by
# accident.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
