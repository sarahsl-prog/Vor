# Vör — environment variable template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must
# never be committed (CLAUDE.md: "All secrets go in .env"). Nothing in
# this file is itself a secret — it is a checked-in list of the variable
# NAMES a fresh clone needs, with placeholder values only.
#
# In a real Cloud Run deployment these are set with `--set-env-vars`
# rather than a `.env` file; see docs/DEPLOY.md, which is the source of
# truth for deployment. This file is for local runs and for knowing what
# a deploy has to provide.

# --- Cloud Tasks audit queue (main.py: _queue_path, _audit_url, _enqueue) ---
# Required. /classify and /sweep raise no error without these — _enqueue()
# absorbs the resulting KeyError and logs it — but no audit is ever
# enqueued, so the whole re-verification loop silently does nothing.
GCP_PROJECT=your-project-id
TASKS_LOCATION=us-central1
TASKS_QUEUE=vor-audit-queue
TASKS_OIDC_SA_EMAIL=vor-scheduler@your-project-id.iam.gserviceaccount.com

# Base URL of the deployed Cloud Run service. Used to build the /audit
# callback URL Cloud Tasks posts back to, and as the OIDC token audience.
SERVICE_URL=https://your-cloud-run-url

# --- Vertex AI / Gemini (read by the google-adk + google-genai clients) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- MLflow tracing (vor_agents/tracing.py) ---
# Optional. Read by the mlflow client itself, not by this repo's code.
# Unset, MLflow falls back to a local ./mlruns file store, which is NOT
# durable on Cloud Run — traces then land in the Firestore pending_traces
# fallback queue instead of a real tracking server. See DEPLOY.md step 5.
MLFLOW_TRACKING_URI=https://your-mlflow-server

# --- Local development only ---
# Path to a service-account key JSON, if you are not using `gcloud auth
# application-default login`. Never commit the key file itself; the
# *.json patterns in .gitignore exist to make that harder to do by
# accident.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
